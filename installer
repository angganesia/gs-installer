#!/bin/bash

# 1. Pastikan PATH mencakup lokasi binary umum
export PATH="$PATH:/usr/bin:/bin:/usr/local/bin:$HOME/bin"

# Cek keberadaan Git
if ! command -v git &> /dev/null && ! git --version &> /dev/null; then
  echo "❌ Git tidak ditemukan di sistem kamu."
  echo "   Silakan install Git terlebih dahulu."
  exit 1
else
  echo "✅ Git sudah terpasang di sistem."
fi

# 2. Tentukan file RC (.zshrc / .bashrc)
TARGET_RC=""
if [ -n "$ZSH_VERSION" ] || [ -f "$HOME/.zshrc" ]; then
  TARGET_RC="$HOME/.zshrc"
elif [ -n "$BASH_VERSION" ] || [ -f "$HOME/.bashrc" ]; then
  TARGET_RC="$HOME/.bashrc"
else
  echo "❌ Tidak dapat menemukan file .bashrc atau .zshrc"
  exit 1
fi

DISPLAY_RC="${TARGET_RC/#$HOME/\~}"

# 3. Hapus fungsi gs() lama jika ada
if grep -q "gs()" "$TARGET_RC"; then
  echo "🗑️  Fungsi gs() lama ditemukan di $DISPLAY_RC. Menghapus versi lama..."
  TMP_FILE=$(mktemp)
  sed '/# Git Auto Add, Commit, Pull, Push/,/^[[:space:]]*}/d; /gs()/,/^[[:space:]]*}/d' "$TARGET_RC" > "$TMP_FILE"
  mv "$TMP_FILE" "$TARGET_RC"
fi

# 4. Masukkan fungsi gs() baru dengan aman (Mencegah error saat open terminal)
cat << 'EOF' >> "$TARGET_RC"

# Git Auto Add, Commit, Pull, Push + Live Watch
gs() {
  # Fitur Help / Panduan Penggunaan
  if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-help" ] || [ "$1" = "-h" ]; then
    echo "=========================================="
    echo "       GS (Git Auto Sync) Help            "
    echo "=========================================="
    echo "Penggunaan:"
    echo "  gs                  Auto add, commit, pull --rebase, & push."
    echo "  gs \"pesan commit\"   Commit dengan pesan kustom."
    echo "  gs watch | w | -w   Memantau path & file yang dimodifikasi secara live."
    echo "  gs help | --help    Menampilkan menu bantuan ini."
    echo "=========================================="
    return 0
  fi

  # Cek apakah berada di dalam repositori Git
  if ! git rev-parse --is-inside-work-tree &> /dev/null; then
    echo "❌ Error: Ini bukan direktori Git."
    return 1
  fi

  # Fitur Live Watch
  if [ "$1" = "watch" ] || [ "$1" = "w" ] || [ "$1" = "-w" ]; then
    local pretty_pwd="${PWD/#$HOME/\~}"
    watch -n 1 -c "
      echo \"📂 \033[1;34mPath Direktori:\033[0m $pretty_pwd\"
      echo \"📄 \033[1;33mFile Terubah:\033[0m\"
      echo \"========================================\"
      git status -s | while read -r line; do
        [ -z \"\$line\" ] && continue
        status=\"\${line:0:2}\"
        file=\"\${line:3}\"
        case \"\$status\" in
          \"M \"|\" M\"|\"MM\") printf \"  \033[1;36m[MODIFIED]\033[0m  ./%s\n\" \"\$file\" ;;
          \"A \"|\" A\")       printf \"  \033[1;32m[ADDED]\033[0m     ./%s\n\" \"\$file\" ;;
          \"D \"|\" D\")       printf \"  \033[1;31m[DELETED]\033[0m   ./%s\n\" \"\$file\" ;;
          \"??\")             printf \"  \033[1;35m[UNTRACKED]\033[0m ./%s\n\" \"\$file\" ;;
          *)                 printf \"  \033[1;33m[%s]\033[0m      ./%s\n\" \"\$status\" \"\$file\" ;;
        esac
      done
      if [ -z \"\$(git status -s)\" ]; then
        echo \"  \033[0;37m(Tidak ada perubahan file)\033[0m\"
      fi
      echo \"========================================\"
      echo \"💡 \033[1;30mTekan Ctrl+C untuk keluar\033[0m\"
    "
    return 0
  fi

  # Cek apakah ada perubahan file
  if [ -z "$(git status -s)" ]; then
    echo "ℹ️ Tidak ada perubahan untuk di-commit."
    return 0
  fi

  local current_branch=$(git branch --show-current)
  echo "🚀 Memproses di branch [$current_branch]..."

  git add . || return 1

  if [ -z "$1" ]; then
    local status_msg=$(git status -s | tr '\n' ' ' | xargs)
    git commit -m "${status_msg:-Auto commit: $(date '+%Y-%m-%d %H:%M:%S')}"
  else
    git commit -m "$1"
  fi

  echo "🔄 Mengunduh pembaruan (pull --rebase)..."
  git pull --rebase origin "$current_branch" || return 1

  echo "📤 Mengunggah perubahan (push)..."
  git push origin "$current_branch" && echo "✅ Berhasil sync ke remote!"
}
EOF

echo "✅ Berhasil menginstall/memperbarui gs() di $DISPLAY_RC"
echo "🔄 Jalankan perintah ini untuk memperbarui shell:"
echo "   source $DISPLAY_RC"
